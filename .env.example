# Postgres (used by the `db` container and to build DATABASE_URL)
POSTGRES_USER=useby
POSTGRES_PASSWORD=changeme
POSTGRES_DB=useby

# Used by `npm run dev` / Prisma CLI when running on the host (outside Docker).
# When running the full stack via docker-compose, the app container gets
# DATABASE_URL pointed at the `db` service instead (see docker-compose.yml).
# Port 5433 (not 5432) is used on the host side to avoid clashing with a
# native Postgres install that may already be listening on 5432.
DATABASE_URL="postgresql://useby:changeme@localhost:5433/useby?schema=public"

# Port the app is published on when running via docker-compose
APP_PORT=3000

# SMTP relay used for missing-product report emails, and the address that
# receives them.
# - `npm run dev` on the host (default below): SMTP_HOST=localhost, since
#   Mailhog's SMTP port is published to the host as 1025.
# - Full stack via `docker compose --profile dev up`: set SMTP_HOST=mailhog
#   instead, so the app container reaches Mailhog over the compose network.
# - Production: point these at your real SMTP relay (with SMTP_USER/PASSWORD
#   if it requires auth) and don't use the dev profile.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@useby.local
# SMTP_USER=
# SMTP_PASSWORD=
REPORT_EMAIL_TO=you@example.com

# Admin panel auth (single admin, no OAuth). Protects catalog/recipe/location
# management, the pending-submission review, and notification settings —
# not the everyday dashboard/dispensa/ricette/scan views.
# ADMIN_PASSWORD_HASH_BASE64 is the bcrypt hash of your password, base64-encoded
# so the raw `$` characters in a bcrypt hash don't get mangled by
# docker-compose's env_file variable interpolation. Generate it with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync(process.argv[1], 10)).toString('base64'))" "yourpassword"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH_BASE64=
# Random string used to sign the admin session cookie, e.g.: openssl rand -hex 32
SESSION_SECRET=
