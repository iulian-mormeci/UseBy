// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LocationType {
  PANTRY
  FRIDGE
  FREEZER
}

enum UnitOfMeasure {
  PIECE
  GRAM
  KILOGRAM
  MILLILITER
  LITER
}

enum ExpiryType {
  USE_BY
  BEST_BEFORE
}

enum MissingProductReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum PendingProductSubmissionStatus {
  PENDING
  EMAILED
  INCLUDED
  REJECTED
}

model Location {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  type       LocationType
  zones      Zone[]
  stockItems StockItem[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Zone {
  id         Int         @id @default(autoincrement())
  locationId Int
  location   Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  stockItems StockItem[]
  createdAt  DateTime    @default(now())

  @@unique([locationId, name])
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id                   Int                        @id @default(autoincrement())
  name                 String
  brand                String?
  barcode              String?                    @unique
  imageUrl             String?
  unit                 UnitOfMeasure              @default(PIECE)
  defaultShelfLifeDays Int?
  categoryId           Int?
  category             Category?                  @relation(fields: [categoryId], references: [id])
  stockItems           StockItem[]
  recipeIngredients    RecipeIngredient[]
  missingReports       MissingProductReport[]
  pendingSubmissions   PendingProductSubmission[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([name])
}

model StockItem {
  id          Int        @id @default(autoincrement())
  productId   Int
  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  locationId  Int
  location    Location   @relation(fields: [locationId], references: [id])
  zoneId      Int?
  zone        Zone?      @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  quantity    Decimal    @default(1)
  expiryDate  DateTime?
  expiryType  ExpiryType @default(USE_BY)
  leadDays    Int?
  purchasedAt DateTime?
  openedAt    DateTime?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([productId])
  @@index([locationId])
  @@index([zoneId])
  @@index([expiryDate])
}

model Recipe {
  id           Int                @id @default(autoincrement())
  title        String
  instructions String
  servings     Int?
  prepMinutes  Int?
  cookMinutes  Int?
  notes        String?
  ingredients  RecipeIngredient[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([title])
}

model RecipeIngredient {
  id        Int      @id @default(autoincrement())
  recipeId  Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Decimal?
  optional  Boolean  @default(false)

  @@unique([recipeId, productId])
}

model MissingProductReport {
  id                Int                        @id @default(autoincrement())
  requestedName     String
  note              String?
  status            MissingProductReportStatus @default(PENDING)
  resolvedProductId Int?
  resolvedProduct   Product?                   @relation(fields: [resolvedProductId], references: [id])
  emailedAt         DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([status])
}

model PendingProductSubmission {
  id        Int                            @id @default(autoincrement())
  barcode   String
  productId Int
  product   Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  status    PendingProductSubmissionStatus @default(PENDING)
  emailedAt DateTime?
  createdAt DateTime                       @default(now())
  updatedAt DateTime                       @updatedAt

  @@index([barcode])
  @@index([status])
}

model NotificationSetting {
  id              Int      @id @default(1)
  defaultLeadDays Int      @default(3)
  updatedAt       DateTime @updatedAt
}
